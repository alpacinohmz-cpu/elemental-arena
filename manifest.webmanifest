{
  "name": "Elemental Arena",
  "short_name": "Elemental Arena",
  "description": "1v1 elemental fighting game — fire, water, wind, earth, lightning.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
